+// The Switch FFmpeg port occasionally returns AVERROR(EINVAL) before it can
+// even read an HTTPS HLS playlist.  libcurl is already used successfully by
+// the provider layer, so HLS gets a second transport path: curl downloads the
+// current playlist/segment, while libavformat still performs all demuxing and
+// decoding.  AVFormatContext::io_open makes the same curl path available to
+// nested HLS playlists, keys and media segments.
+struct CurlMemoryIO {
+    std::vector<unsigned char> data;
+    size_t pos = 0;
+};
+
+struct CurlIOBridge {
+    ProxyConfig proxy{};
+    VideoRequestContext request;
+    const std::atomic<bool>* cancel = nullptr;
+};
+
+static size_t curl_memory_write(void* ptr, size_t size, size_t nmemb, void* userdata) {
+    if (!ptr || !userdata) return 0;
+    auto* out = static_cast<std::vector<unsigned char>*>(userdata);
+    const size_t bytes = size * nmemb;
+    const auto* begin = static_cast<const unsigned char*>(ptr);
+    out->insert(out->end(), begin, begin + bytes);
+    return bytes;
+}
+
+static bool curl_memory_reset(void* userdata) {
+    auto* out = static_cast<std::vector<unsigned char>*>(userdata);
+    if (!out) return false;
+    out->clear();
+    return true;
+}
+
+static int curl_avio_read(void* opaque, uint8_t* buf, int buf_size) {
+    auto* io = static_cast<CurlMemoryIO*>(opaque);
+    if (!io || !buf || buf_size <= 0) return AVERROR(EINVAL);
+    if (io->pos >= io->data.size()) return AVERROR_EOF;
+    const size_t available = io->data.size() - io->pos;
+    const size_t take = std::min(available, (size_t)buf_size);
+    std::memcpy(buf, io->data.data() + io->pos, take);
+    io->pos += take;
+    return (int)take;
+}
+
+static int64_t curl_avio_seek(void* opaque, int64_t offset, int whence) {
+    auto* io = static_cast<CurlMemoryIO*>(opaque);
+    if (!io) return AVERROR(EINVAL);
+    if (whence == AVSEEK_SIZE) return (int64_t)io->data.size();
+    const int base_whence = whence & ~AVSEEK_FORCE;
+    int64_t base = 0;
+    if (base_whence == SEEK_SET) base = 0;
+    else if (base_whence == SEEK_CUR) base = (int64_t)io->pos;
+    else if (base_whence == SEEK_END) base = (int64_t)io->data.size();
+    else return AVERROR(EINVAL);
+    const int64_t next = base + offset;
+    if (next < 0 || next > (int64_t)io->data.size()) return AVERROR(EINVAL);
+    io->pos = (size_t)next;
+    return next;
+}
+
+static AVIOContext* make_curl_memory_avio(std::vector<unsigned char>&& data) {
+    auto* state = new (std::nothrow) CurlMemoryIO();
+    if (!state) return nullptr;
+    state->data = std::move(data);
+    constexpr int kAvioBufferSize = 64 * 1024;
+    auto* buffer = static_cast<unsigned char*>(av_malloc(kAvioBufferSize));
+    if (!buffer) { delete state; return nullptr; }
+    AVIOContext* pb = avio_alloc_context(buffer, kAvioBufferSize, 0, state,
+                                         curl_avio_read, nullptr, curl_avio_seek);
+    if (!pb) { av_free(buffer); delete state; return nullptr; }
+    pb->seekable = AVIO_SEEKABLE_NORMAL;
+    return pb;
+}
+
+static void free_curl_memory_avio(AVIOContext* pb) {
+    if (!pb) return;
+    auto* state = static_cast<CurlMemoryIO*>(pb->opaque);
+    pb->opaque = nullptr;
+    delete state;
+    avio_context_free(&pb);
+}
+
+static bool curl_fetch_media_resource(const CurlIOBridge& bridge,
+                                      const std::string& url,
+                                      VideoNetworkStage stage,
+                                      std::vector<unsigned char>& out,
+                                      std::string* effective_url,
+                                      std::string& error) {
+    out.clear();
+    CURL* curl = curl_easy_init();
+    if (!curl) { error = "curl 初始化失败"; return false; }
+    curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
+    curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, curl_memory_write);
+    curl_easy_setopt(curl, CURLOPT_WRITEDATA, &out);
+    if (!bridge.request.referer.empty())
+        curl_easy_setopt(curl, CURLOPT_REFERER, bridge.request.referer.c_str());
+
+    struct curl_slist* extra_headers = nullptr;
+    if (!bridge.request.origin.empty())
+        extra_headers = curl_slist_append(extra_headers,
+            ("Origin: " + bridge.request.origin).c_str());
+    if (!bridge.request.cookie.empty())
+        extra_headers = curl_slist_append(extra_headers,
+            ("Cookie: " + bridge.request.cookie).c_str());
+    if (extra_headers) curl_easy_setopt(curl, CURLOPT_HTTPHEADER, extra_headers);
+
+    NetworkOptions options;
+    options.connect_timeout_seconds = 12;
+    options.total_timeout_seconds = 45;
+    options.low_speed_limit = 512;
+    options.low_speed_seconds = 20;
+    options.max_redirects = 10;
+    options.max_attempts = 3;
+    options.allow_ipv4_fallback = bridge.proxy.mode == PROXY_MODE_DIRECT;
+    if (!bridge.request.user_agent.empty()) options.user_agent = bridge.request.user_agent;
+    network_apply_proxy(curl, bridge.proxy);
+    const NetworkResult result = network_perform_get(
+        curl, stage, curl_memory_reset, &out, options, bridge.cancel);
+    if (effective_url) *effective_url = result.effective_url;
+    if (!result.success()) error = result.error.empty() ? "curl 请求失败" : result.error;
+    if (extra_headers) curl_slist_free_all(extra_headers);
+    curl_easy_cleanup(curl);
+    return result.success() && !out.empty();
+}
+
+static int curl_io_open_cb(AVFormatContext* s, AVIOContext** pb,
+                           const char* url, int flags, AVDictionary**) {
+    if (!s || !pb || !url || (flags & AVIO_FLAG_WRITE)) return AVERROR(EINVAL);
+    auto* bridge = static_cast<CurlIOBridge*>(s->opaque);
+    if (!bridge) return AVERROR(EINVAL);
+    std::vector<unsigned char> body;
+    std::string effective, error;
+    VideoNetworkStage stage = std::strstr(url, ".m3u8")
+        ? VideoNetworkStage::MediaPlaylist : VideoNetworkStage::MediaSegment;
+    if (!curl_fetch_media_resource(*bridge, url, stage, body, &effective, error))
+        return AVERROR(EIO);
+    *pb = make_curl_memory_avio(std::move(body));
+    return *pb ? 0 : AVERROR(ENOMEM);
+}
+
+static int curl_io_close_cb(AVFormatContext*, AVIOContext* pb) {
+    free_curl_memory_avio(pb);
+    return 0;
+}
